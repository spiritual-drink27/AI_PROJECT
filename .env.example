# Copy this file to .env and paste your key. .env is gitignored: never commit a key.

LLM_API_KEY=paste_your_groq_key_here

# Defaults (Groq, free tier). Change only if needed.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Backup option: Google Gemini (key from https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
